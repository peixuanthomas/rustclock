{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clock",
  "version": "0.1.3",
  "identifier": "com.rustclock.clock",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Clock",
        "width": 1600,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "fullscreen": true,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    }
  }
}
